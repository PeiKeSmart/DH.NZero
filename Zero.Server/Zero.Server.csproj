<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyTitle>RPC网络服务</AssemblyTitle>
    <Description>高性能，长连接，数据接口</Description>
    <Company>湖北登灏科技有限公司</Company>
    <Copyright>©2020-2025 湖北登灏科技有限公司</Copyright>
    <VersionPrefix>4.22</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Server</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Agent" Version="10.15.2026.402" />
    <PackageReference Include="NewLife.Core" Version="11.14.2026.408-beta0823" />
    <PackageReference Include="NewLife.Redis" Version="6.5.2026.403" />
    <PackageReference Include="NewLife.Stardust" Version="3.7.2026.403" />
    <PackageReference Include="NewLife.XCode" Version="11.25.2026.407-beta0827" />
  </ItemGroup>

</Project>
